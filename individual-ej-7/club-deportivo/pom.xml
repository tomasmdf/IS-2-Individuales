<?xml version="1.0" encoding="UTF-8"?>
<!--
    ========================================================================================
    SISTEMA DE GESTIÓN DE CLUB DEPORTIVO - ARCHIVO POM.XML (MAVEN)
    ========================================================================================
    Este archivo define el modelo de proyecto de objetos (Project Object Model) para Maven.
    Administra dependencias, plugins de compilación y empaquetado, y la versión de Spring Boot.

    Arquitectura:
    - Spring Boot 3.3.4: Framework base con soporte para Java 17, 21 y 22.
    - Spring MVC & Thymeleaf: Motor de plantillas del lado del servidor integrado con Sneat.
    - Spring Data JPA & Hibernate: Capa de persistencia ORM.
    - MySQL Connector / J: Conector oficial para persistencia relacional en producción.
    - H2 Database: Base de datos en memoria para pruebas unitarias e integración aisladas.
    - Spring Security 6: Control de acceso, autenticación por formulario y roles.
    - Bean Validation: Validación declarativa de DTOs con anotaciones (@NotBlank, @NotNull, etc.).
    ========================================================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/> <!-- Busca en los repositorios centrales de Maven -->
    </parent>

    <groupId>com.clubdeportivo</groupId>
    <artifactId>club-deportivo</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>club-deportivo</name>
    <description>Sistema Integral de Gestión de Socios, Accesos y Pagos - Club Deportivo</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <dependencies>
        <!-- ========================================================================== -->
        <!-- SPRING BOOT WEB & MVC                                                      -->
        <!-- Incluye Tomcat embebido, Spring MVC, Jackson para serialización JSON.       -->
        <!-- ========================================================================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- ========================================================================== -->
        <!-- MOTOR DE VISTAS THYMELEAF                                                  -->
        <!-- Permite renderizar HTML5 dinámico integrando la plantilla Sneat.           -->
        <!-- ========================================================================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <!-- ========================================================================== -->
        <!-- DIALECTO THYMELEAF PARA SPRING SECURITY                                   -->
        <!-- Permite usar sec:authorize, sec:authentication en las plantillas HTML.    -->
        <!-- ========================================================================== -->
        <dependency>
            <groupId>org.thymeleaf.extras</groupId>
            <artifactId>thymeleaf-extras-springsecurity6</artifactId>
        </dependency>

        <!-- ========================================================================== -->
        <!-- SPRING DATA JPA & HIBERNATE ORM                                            -->
        <!-- Mapeo Objeto-Relacional, repositorios automáticos, auditoría de entidades. -->
        <!-- ========================================================================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- ========================================================================== -->
        <!-- SPRING SECURITY 6                                                          -->
        <!-- Autenticación, autorización basada en roles (ADMIN, RECEPCIONISTA, SOCIO), -->
        <!-- encriptación BCrypt, protección CSRF y filtros de sesión.                  -->
        <!-- ========================================================================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- ========================================================================== -->
        <!-- VALIDACIÓN DE DATOS (JAKARTA BEAN VALIDATION / HIBERNATE VALIDATOR)       -->
        <!-- Validación de DTOs en controladores mediante @Valid, @NotNull, @Size, etc. -->
        <!-- ========================================================================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ========================================================================== -->
        <!-- CONECTOR MYSQL                                                             -->
        <!-- Driver JDBC oficial para la conexión con el servidor MySQL 8+.             -->
        <!-- ========================================================================== -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ========================================================================== -->
        <!-- BASE DE DATOS H2 EN MEMORIA                                               -->
        <!-- Para pruebas unitarias y de integración rápidas sin requerir MySQL activo. -->
        <!-- ========================================================================== -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ========================================================================== -->
        <!-- SPRING BOOT TEST & JUNIT 5 & MOCKITO                                       -->
        <!-- Testing unitario y de integración para servicios, mappers y controladores. -->
        <!-- ========================================================================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Plugin oficial de Spring Boot para empaquetar en un JAR ejecutable con Tomcat -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- Plugin del compilador Java configurado con UTF-8 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
