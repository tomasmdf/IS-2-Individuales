<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================================
  pom.xml  -  Descriptor de Maven del "Sistema de Gestión Escolar"
  ============================================================================
  Maven es la herramienta que:
    1) descarga las dependencias (librerías) declaradas abajo,
    2) compila el código Java,
    3) empaqueta la aplicación en un .jar ejecutable (spring-boot-maven-plugin).

  El <parent> (spring-boot-starter-parent) fija las versiones compatibles entre
  sí de TODAS las librerías de Spring, Hibernate, Thymeleaf, etc.  Por eso las
  dependencias de abajo NO llevan <version>: la hereda el parent.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.11</version>
        <relativePath/> <!-- resolver el parent desde el repositorio, no desde el disco -->
    </parent>

    <groupId>com.colegio</groupId>
    <artifactId>sistema-colegio</artifactId>
    <version>1.0.0</version>
    <name>sistema-colegio</name>
    <description>Sistema de gestión escolar: alumnos, grados, aulas, docentes y notas (Spring Boot + Thymeleaf + Sneat)</description>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- CAPA CONTROLADOR: Spring MVC + Tomcat embebido (@Controller, @GetMapping, ...) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- CAPA VISTA: motor de plantillas Thymeleaf (archivos .html en src/main/resources/templates) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <!-- Integración Thymeleaf + Spring Security: habilita sec:authorize, sec:authentication, etc. en las vistas -->
        <dependency>
            <groupId>org.thymeleaf.extras</groupId>
            <artifactId>thymeleaf-extras-springsecurity6</artifactId>
        </dependency>

        <!-- CAPA DE PERSISTENCIA (ORM): Spring Data JPA + Hibernate -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- SEGURIDAD: autenticación (login), autorización por roles, BCrypt, CSRF -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- VALIDACIÓN: Bean Validation (@NotBlank, @Email, @Past, ...) con Hibernate Validator -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- CORREO: JavaMailSender para el correo de bienvenida -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- Lombok: genera en tiempo de compilación getters/setters/constructores/builder
             a partir de anotaciones (@Getter, @Setter, @Builder, etc.), reduce el código
             repetitivo ("boilerplate") en Entidades y DTOs. No forma parte del jar final. -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Driver JDBC de MySQL (sólo necesario en tiempo de ejecución) -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Recarga automática en desarrollo (opcional) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!-- Pruebas -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Genera el JAR ejecutable ("fat jar") y habilita `mvn spring-boot:run` -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
